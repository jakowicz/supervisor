# Never commit real credentials. Worker adapters are intentionally command based
# until their provider integrations are configured.
SUPERVISOR_REPO_ROOT=..
# Runtime evidence lives at the controlled project root when the supervisor is
# checked out at supervisor.
SUPERVISOR_DATABASE_PATH=../.state/supervisor.sqlite3

# Agent adapters. Keep these commented until you have reviewed the safety gate
# below. Run the supervisor from supervisor after activating .venv.
# Execution order for autonomous coding agents. A project can use Codex only:
# SUPERVISOR_CODING_AGENTS=codex
# Full execution pipeline. Each name must be an enabled Supervisor stage; list
# every stage this project should run, in order. Codex-only coding example:
# SUPERVISOR_AGENT_ORDER=codex,test,browser,visual_review,completion_audit,git_publish
# QWEN_CODER_COMMAND=./.venv/bin/python scripts/qwen_worker.py {task_file}
# OPENHANDS_COMMAND=./.venv/bin/python scripts/openhands_worker.py {task_file}
# CODEX_COMMAND=./.venv/bin/python scripts/codex_worker.py {task_file}

# Both coding adapters refuse to modify files until this exact value is set.
# SUPERVISOR_ALLOW_AUTONOMOUS_WRITES=true
# Optional: pin the model configured in each CLI.
# QWEN_MODEL=
# Qwen Code uses these local Ollama settings as its OpenAI-compatible provider.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# CODEX_MODEL=
# OpenHands' adapter enables --override-with-envs and converts the shared `/v1`
# endpoint below to Ollama's native root endpoint for its `ollama/...` provider.
# Keep one shared URL; do not add a separate OpenHands URL variable.
# LLM_MODEL=ollama/qwen3-coder-next
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# Optional: worker timeout in seconds (default: 1800).
# SUPERVISOR_WORKER_TIMEOUT_SECONDS=1800
# Optional: replace Flutter validation for a lightweight or non-Flutter project.
# The command is parsed without a shell and runs in SUPERVISOR_REPO_ROOT.
# SUPERVISOR_TEST_COMMAND=node --test tests
# Optional: stop a Qwen attempt that emits no CLI or tool output (default: 300).
# The Qwen stream watchdog is kept in sync with this value.
# SUPERVISOR_QWEN_IDLE_TIMEOUT_SECONDS=600
# Optional live-terminal heartbeat while an agent is silent (default: 30).
# SUPERVISOR_PROGRESS_HEARTBEAT_SECONDS=30
# Total implementation attempts including the first. Defaults: Qwen=1,
# OpenHands=1, Codex fallback=3. Codex final verifier/fixer first runs once
# independently, then receives up to three post-QA repair attempts.
# SUPERVISOR_QWEN_ATTEMPTS=1
# SUPERVISOR_OPENHANDS_ATTEMPTS=1
# SUPERVISOR_CODEX_ATTEMPTS=3
# SUPERVISOR_CODEX_FINAL_ATTEMPTS=3
# Preferred dashboard port. When it is busy, `emberhold-dashboard` chooses the
# next free localhost port unless you explicitly supply --port.
# SUPERVISOR_DASHBOARD_PORT=8765
# Publishing remains disabled until the workspace is clean and this policy is
# reviewed. A task may commit/push only after every validation gate passes.
# SUPERVISOR_AUTO_COMMIT=true
# SUPERVISOR_AUTO_PUSH=true

# Browser QA. Install the Playwright package/browser first; see README.
# BROWSER_QA_COMMAND=./.venv/bin/python scripts/browser_worker.py {task_file}
# VISUAL_REVIEW_COMMAND=

# Local Langfuse / OpenTelemetry (disabled unless explicitly enabled). Start
# supervisor/observability/setup-local.sh first, create the initial
# Langfuse project at http://127.0.0.1:3001, then copy its project API keys here.
# SUPERVISOR_OBSERVABILITY_ENABLED=true
# SUPERVISOR_OBSERVABILITY_ENVIRONMENT=local
# Use -1 to export complete raw agent/test/browser evidence to local Langfuse.
# SUPERVISOR_OBSERVABILITY_RAW_LOG_MAX_CHARS=-1
# LANGFUSE_BASE_URL=http://127.0.0.1:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
